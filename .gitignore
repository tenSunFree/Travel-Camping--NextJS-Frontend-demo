# ============================================================
# Dependencies
# Installed packages (generated by npm/yarn/pnpm). Never commit.
# ============================================================
node_modules/

# ============================================================
# Next.js build output
# Build artifacts created by `next dev` / `next build`. Never commit.
# ============================================================
.next/
out/

# ============================================================
# Other build outputs (optional)
# Some setups/tools may output these folders. Safe to ignore.
# ============================================================
dist/
build/

# ============================================================
# Logs
# Debug logs generated by package managers or tools. Never commit.
# ============================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-error.log*
lerna-debug.log*

# ============================================================
# Environment variables / secrets
# Typically contain API keys, tokens, DB URLs. Never commit.
# Keep `.env.example` as a safe template.
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Caches
# Tooling caches that are regenerated automatically. Never commit.
# ============================================================
.cache/
.turbo/                 # Turborepo cache (if you use Turborepo)

# ============================================================
# TypeScript
# Incremental build info generated by TypeScript. Never commit.
# ============================================================
*.tsbuildinfo

# ============================================================
# Linting
# ESLint cache file. Never commit.
# ============================================================
.eslintcache

# ============================================================
# Testing / coverage
# Coverage reports and test artifacts. Never commit.
# ============================================================
coverage/
test-results/           # Playwright (optional)
playwright-report/      # Playwright (optional)

# ============================================================
# OS-generated files
# Created by macOS / Windows. Never commit.
# ============================================================
.DS_Store
Thumbs.db
Desktop.ini

# ============================================================
# Editor / IDE settings
# Ignore personal IDE files; optionally allow shared VS Code configs.
# ============================================================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

.idea/
*.iml

# ============================================================
# Security-sensitive files
# Keys/certificates should never be committed.
# ============================================================
*.pem
*.key
*.p12
*.pfx

# ============================================================
# Misc temporary files
# Swap/backup files created by editors.
# ============================================================
*.swp
*.swo
*~